{
  "name": "one-tool-to-rule-them-all",
  "version": "2.0.3",
  "description": "Comic archives in. Real ebooks out. Nothing leaves your machine.",
  "author": "Brightwav3",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.brightwav3.onetool",
    "productName": "One Tool to Rule Them All",
    "copyright": "Copyright (c) 2026 Brightwav3",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "pdf_to_md.cjs"
    ],
    "extraResources": [
      {
        "from": "../converter",
        "to": "converter",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!.dropped/**"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Brightwav3",
        "repo": "One-tool-to-rule-them-all"
      }
    ],
    "win": {
      "target": [
        "nsis-web"
      ],
      "icon": "build/icon.ico",
      "artifactName": "OneTool-Web-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "One Tool to Rule Them All",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "license": "../LICENSE"
    },
    "nsisWeb": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@firecrawl/pdf-inspector": "^1.11.2",
    "electron-updater": "^6.8.9"
  }
}
